    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "jetonJoueur",
      "value": "pw_demo_LeaPixel_2026_9f8e7d6c5b4a"
    },
    {
      "key": "jetonSupport",
      "value": ""
    },
    {
      "key": "referenceTicket",
      "value": ""
    }
  ],
